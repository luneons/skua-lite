# Copy this file to .env and replace the placeholders.
SKUA_AI_BASE_URL=https://provider.example/v1
SKUA_AI_API_KEY=your-api-key
SKUA_AI_MODEL=your-model
SKUA_AI_TIMEOUT=60
SKUA_AI_MAX_TOKENS=500
SKUA_AI_TEMPERATURE=0.4

# --- Riset otomatis (opsional) ---------------------------------------------
# Bot memakai Bing + Wayback secara default ketika model menulis `RESEARCH:`.
# Ganti hanya bila kamu punya proxy atau search API sendiri di jaringan bot.
# `{query}` diganti dengan query ter-encode.
# SKUA_RESEARCH_URL=https://www.bing.com/search?q={query}
# Template API Wayback; `{url}` diganti URL halaman AQW Wiki.
# SKUA_RESEARCH_WAYBACK=https://archive.org/wayback/available?url={url}
# Timeout detik untuk pencarian dan pengambilan halaman.
# SKUA_RESEARCH_TIMEOUT=8
# SKUA_RESEARCH_PAGE_TIMEOUT=12
# Batas jumlah topik riset per pesan chat (1 = satu putaran, aman).
# SKUA_RESEARCH_MAX_ROUNDS=1

# --- Admin Mode pemilik (opsional) -----------------------------------------
# Saat akun MELE/ME LE terdeteksi masuk, AI dan Admin Mode otomatis aktif.
# Perintah di chat zone: !cari, !join, !move, !status, !bantuan, !upgrade,
# !exec, dan !run. Hanya UID/nama akun pemilik aktif yang dapat menjalankannya.
#
# CLI agent lokal untuk !cari dan !upgrade (default: hermes).
# SKUA_AGENT_COMMAND=hermes
# Timeout keseluruhan web/self-upgrade dalam detik.
# SKUA_ADMIN_TIMEOUT=600
# Timeout untuk !exec dan !run.
# SKUA_ADMIN_CODE_TIMEOUT=30
# !run selalu dibatasi allowlist perintah baca-saja. Default mati; aktifkan
# !exec tetap tersedia dengan child environment yang
# membuang SKUA_AI_* dan variabel secret umum.
# SKUA_ADMIN_SHELL=0

# --- Panel Kontrol Telegram (opsional, mode farming) ------------------------
# Isi token dari @BotFather untuk mengendalikan bot lewat Telegram:
# SKUA_TELEGRAM_TOKEN=123456789:ABCDefGhIjKlMnOpQrStUvWxYz
# Kunci hanya ke ID Telegram pemilik (lihat numeric ID saat /start pertama kali):
# SKUA_TELEGRAM_OWNER_ID=123456789
